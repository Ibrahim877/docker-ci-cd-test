# server/.dockerignore (Laravel üçün)

# Dependencies
vendor/
node_modules/
composer.phar

# Laravel specific
bootstrap/cache/*
storage/app/*
!storage/app/public
!storage/app/.gitignore
storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore

# Environment files
.env
.env.backup
.env.production
.env.local
.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# PHPUnit
.phpunit.result.cache
phpunit.xml
/phpunit.xml

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Documentation
README.md
*.md

# Temporary files
tmp/
temp/

# Build artifacts
/public/hot
/public/storage
/storage/*.key

# Testing
tests/
.phpunit.cache

# Package managers
composer.lock
package-lock.json
yarn.lock

# Backup files
*.bak
*.backup

# Cache
.cache/

# Misc
.editorconfig
.styleci.yml
.php_cs
.php_cs.cache
